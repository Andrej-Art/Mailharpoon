# All variables are optional – every layer degrades gracefully without its key.

# Google Safe Browsing v4 (free): https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=

# URLhaus by abuse.ch (free Auth-Key): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Claude AI analyst layer: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (~0.05 ct per scan). Set claude-sonnet-5-5 or claude-opus-5-5 for a stronger model.
ANTHROPIC_MODEL=

# Rendered page check in a headless browser. On Vercel the bundled Chromium is used,
# locally an installed Google Chrome. Set CHROME_PATH if Chrome lives elsewhere,
# or RENDER_DISABLED=1 to switch the browser check off.
CHROME_PATH=
RENDER_DISABLED=

# Scans per IP per 10 minutes (per serverless instance). Default 30.
SCAN_RATE_LIMIT=

# Public URL, used for canonical / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://mailharpoon.vercel.app
