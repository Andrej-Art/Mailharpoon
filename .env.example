# All variables are optional – every layer degrades gracefully without its key.

# Google Safe Browsing v4 (free): https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=

# URLhaus by abuse.ch (free Auth-Key): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Claude AI analyst layer: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (~0.05 ct per scan). Set claude-sonnet-5-5 or claude-opus-5-5 for a stronger model.
# The same key also powers reading screenshots of messages (/api/screenshot) and the news summaries.
ANTHROPIC_MODEL=
# Model for the news summaries. Defaults to claude-sonnet-5-5; each article is summarised only once.
NEWS_MODEL=
# Set to 1 to log failed or cut-off news summaries on the server.
NEWS_DEBUG=

# Rendered page check in a headless browser. On Vercel the bundled Chromium is used,
# locally an installed Google Chrome. Set CHROME_PATH if Chrome lives elsewhere,
# or RENDER_DISABLED=1 to switch the browser check off.
CHROME_PATH=
RENDER_DISABLED=

# Scans per IP per 10 minutes (per serverless instance). Default 30.
SCAN_RATE_LIMIT=

# List of currently circulating phishing on the news page: Upstash Redis via the Vercel Marketplace.
# The integration sets KV_REST_API_URL / KV_REST_API_TOKEN (a custom prefix such as MY_KV_REST_API_URL
# also works); UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.
# Without them scans are not counted and only domains reported by OpenPhish and URLhaus are listed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Different people who must have checked a domain within 7 days before it is listed. Default 3.
TREND_MIN_PEOPLE=

# Public URL, used for canonical / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://mailharpoon.vercel.app

# Contact form: e-mail delivery through Resend (https://resend.com, free up to 3,000 mails a month).
# Without a key the form says it is unavailable and points to the e-mail address.
RESEND_API_KEY=
# Recipient (defaults to the address in src/content/legal.ts) and sender. Without a verified domain
# at Resend, the sender must stay onboarding@resend.dev and mail only reaches the Resend account address.
CONTACT_TO=
CONTACT_FROM=
